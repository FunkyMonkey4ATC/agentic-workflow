{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ParsedRadioCall",
  "description": "FMK-7 data contract. One radio transmission may contain zero or more clearances.",
  "type": "object",
  "additionalProperties": false,
  "required": ["speaker", "clearances", "flags"],
  "properties": {
    "speaker": { "type": "string", "enum": ["tower", "ground", "pilot", "vehicle", "unknown"] },
    "clearances": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["callsign", "action", "runway", "taxiway", "confidence"],
        "properties": {
          "callsign": { "type": "string", "description": "Normalized, e.g. 'TRUCK 1', 'JAZZ 646'. Empty string if unknown." },
          "action": {
            "type": "string",
            "enum": ["cleared_to_land", "cleared_for_takeoff", "line_up_and_wait", "cross_runway", "hold_short", "taxi", "stop", "readback"]
          },
          "runway": { "type": "string", "description": "e.g. '4', '22', '13', '31'. Empty string if none." },
          "taxiway": { "type": "string", "description": "e.g. 'D'. Empty string if none." },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "flags": {
      "type": "array",
      "items": { "type": "string", "enum": ["correction", "low_confidence", "partial", "emergency_phrase", "non_clearance"] }
    }
  }
}
